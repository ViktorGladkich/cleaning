# Contact form delivery. Set these in Vercel → Project → Settings → Environment Variables.
# Without them the form tells visitors to call instead of pretending to send.
SMTP_HOST=
# 465 = implicit TLS, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER and to the address in src/lib/constants.ts
CONTACT_MAIL_FROM=
CONTACT_MAIL_TO=
# Optional: separate inbox for job applications (/karriere); defaults to CONTACT_MAIL_TO
APPLICATION_MAIL_TO=

# Optional: production URL used for canonical links, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.tadiks-cleaning.de
